(struct Exam (student : Text) (score : Float = 0, (<= 0 score)) (max : Float = 20) (invariant (<= score max)) (private note : Text = "") (grade : Int, (in grade (.. 1 5))))
(struct Marker)
(fun Exam.passes () in Bool = (>= (. self score) (/ (. self max) 2)))
(fun Exam.add ((var self) (points)) [(+= (. self score) points)])
