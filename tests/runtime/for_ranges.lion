fun is_prime(n in Int) in Bool:
    if n < 2: return false ;
    for d in 2..n - 1:
        if d * d > n: break ;
        if n mod d == 0: return false ;
    ;
    return true
;
var count = 0
for p in 2..1000:
    if is_prime(p): count += 1 ;
;
show("{count} premiers")
let r = 1..5
show(r)
show(3 in r)
show(7 in r)
var total = 0
for i in r:
    if i == 3: continue ;
    total += i
;
show(total)
for i in 9..1: show("jamais") ;
var last = 0
for i in 9223372036854775805..9223372036854775807: last = i ;
show(last)
for i in 1..3:
    for j in 1..i:
        show("{i}.{j}")
    ;
;
