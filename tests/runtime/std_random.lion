// The same seed gives the same numbers, everywhere (§23).
use random
var a = random.Generator(7)
var b = random.Generator(7)
let first = [a.float(), x in 1..3]
let second = [b.float(), x in 1..3]
show(first == second)
show(first)
var dice = random.Generator(1)
show([dice.int(1, 6), x in 1..10])
let r = random.int(5, 5)
show(r)
let u = random.float()
show(u >= 0.0 and u < 1.0)
show(dice.int(3, 2))
