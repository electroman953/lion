use text
show(text.split("a,b,,c", ","))
show(text.join(["a", "b", "c"], " - "))
show(text.upper("Élan"))
show(text.lower("LION"))
show("[{text.trim("  x y  ")}]")
show(text.contains("lionceau", "ion"))
show(text.starts_with("lion", "li"))
show(text.ends_with("lion", "on"))
show(text.replace("a-b-c", "-", "+"))
show(text.find("héllo", "llo"))
show(text.find("abc", "z"))
show(text.lines("one\ntwo\n\nthree\n"))
show(text.split("abc", ""))
