// `parallel` gives the results of the sequential computation (§19.2, C60).
fun is_prime(n in Int) in Bool:
    if n < 2: return false ;
    for d in 2..isqrt(n):
        if n mod d == 0: return false ;
    ;
    return true
;
let primes = parallel {p in 2..100, is_prime(p)}
show(primes.size)
let twins = {(p, p + 2), p in primes, p + 2 in primes}
show(twins)
let squares = parallel [x * x, x in 1..5]
show(squares)
parallel for x in 1..3:
    var local = x
    local *= 10
    show(local)
;
