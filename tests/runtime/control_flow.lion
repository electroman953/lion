var i = 0
var total = 0
while i < 10:
    i += 1
    if i mod 3 == 0: continue ;
    if i > 8: break ;
    total += i
;
show("i = {i}, total = {total}")

// Nested loops: `break` leaves the innermost one
var row = 1
while row <= 3:
    var col = 1
    var line = ""
    while true:
        line = "{line}{row * col} "
        if col == row: break ;
        col += 1
    ;
    show(line)
    row += 1
;

let x = 7
if x < 5:
    show("small")
elif x < 10:
    show("medium")
else:
    show("large")
;
show(if x mod 2 == 0 then "even" else "odd")
show(if x > 5 then 1 else 0.5)
let grade in Text
if x >= 5: grade = "pass" else: grade = "fail" ;
show(grade)
while false: show("never") ;
