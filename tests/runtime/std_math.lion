use math
show(math.pi)
show(math.e)
show(math.sqrt(16.0))
show(math.abs(-2))
show(math.abs(-2.5))
show(math.min(3, 1))
show(math.max(1.5, 2.5))
show(math.mean([1, 2, 3, 4]))
show(round(math.sin(math.pi / 2) * 1000))
show(math.atan2(1.0, 1.0) * 4)
show(math.log(math.e))
show(math.log10(1000.0))
show(math.exp(0.0))
show(math.sqrt(-1.0))
