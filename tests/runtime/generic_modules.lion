// The generic structures of another module (§15.1, §20.2).
use generic.geo

let p = geo.Pair(1, "one")
show(p)
let q = (2, "two") in geo.Pair of (Int, Text)
show(q.second)
fun describe(pair in geo.Pair of (Int, Text)) in Text = "{pair.first}: {pair.second}"
show(describe(p))
show(geo.swap(p))
fun keys(l in List of geo.Pair of (K, V)) in List of K, K in Type, V in Type = [x.first, x in l]
show(keys([geo.Pair("a", 1), geo.Pair("b", 2)]))
show(geo.Box(3))

// A generic trait of the module.
struct Rope:
    length in Float
;
fun Rope.measure() in Float = self.length
fun sizes(l in List of geo.Measured of Float) in List of Float = [m.measure(), m in l]
show(sizes([Rope(2.5), Rope(1.0)]))
show(Rope(3.0) in geo.Measured of Float)
fun measured(m in geo.Measured of U) in U, U in Type = m.measure()
show(measured(Rope(4.5)))
