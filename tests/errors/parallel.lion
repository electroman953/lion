fun is_prime(n in Int) in Bool:
    if n < 2: return false ;
    for d in 2..isqrt(n):
        if n mod d == 0: return false ;
    ;
    return true
;
let primes = parallel {p in 2..100, is_prime(p)}
show(primes.size)
let squares = parallel [x * x, x in 1..5]
show(squares)
var total = 0
fun bump() modifies total:
    total += 1
;
fun indirect() in Int:
    bump()
    return 1
;
let bad = parallel [indirect(), x in 1..3]
parallel for x in 1..3:
    total += x
;
parallel for x in 1..3:
    var local = x
    local += 1
    show(local)
;
let nope = parallel [1, 2]
