script
  locals
    grades#0 var List of Float
    passed#1 let List of Float
    best#2 let Float
    g#3 let Float
    %t#4 temp List of Float
  body
    grades#0 = (list (int_to_float 12) 8.5)
    grades#0[1] = (add_float (index grades#0 1) (int_to_float 1))
    grades#0.add((int_to_float 14))
    passed#1 = (block [%t#4 = (list); for g#3 in grades#0; if (ge_float g#3 (int_to_float 10)); %t#4.add(g#3); end; end] %t#4)
    best#2 = (if (in_list 14.0 grades#0) (last grades#0) (first grades#0))
