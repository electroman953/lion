exit: 0
----- stdout
script
  locals
    grades#0 var List of Float
    passed#1 let List of Float
    best#2 let Float
    %t#3 temp Int
    g#4 let Float
    %t#5 temp List of Float
  body
    grades#0 = (list (int_to_float 12) 8.5)
    %t#3 = 1
    grades#0[%t#3] = (add_float (index grades#0 %t#3) (int_to_float 1))
    grades#0.add((int_to_float 14))
    passed#1 = (block [%t#5 = (list); for g#4 in grades#0; if (ge_float g#4 (int_to_float 10)); %t#5.add(g#4); end; end] %t#5)
    best#2 = (if (in_list 14.0 grades#0) (last grades#0) (first grades#0))
