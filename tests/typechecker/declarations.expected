exit: 0
----- stdout
locals
  count#0 var Int
  count#1 let Text
  x#2 let Int
  x#3 let Int
  e#4 let Text
  d#5 var Float
body
  count#0 = 0
  count#1 = "zero"
  x#2 = 1
  x#3 = (add_int x#2 1)
  e#4 = "later"
  d#5 = (int_to_float 3)
  (show (concat count#1 " " (to_text x#3) " " e#4 " " (to_text d#5)))
----- stderr
