exit: 0
----- stdout
script
  locals
    e#0 let Text
    d#1 var Float
    count#2 var Int
    count#3 let Text
    x#4 let Int
    x#5 let Int
  body
    count#2 = 0
    count#3 = "zero"
    x#4 = 1
    x#5 = (add_int x#4 1)
    e#0 = "later"
    d#1 = (int_to_float 3)
    (show (concat count#3 " " (to_text x#5) " " e#0 " " (to_text d#1)))
----- stderr
