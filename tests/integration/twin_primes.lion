// The second half of program 27.2 (§27.2), on a smaller interval: sets built by
// comprehension, in parallel, and membership in a Set (§16, §19.2).
fun is_prime(n in Int) in Bool:
    if n < 2: return false ;
    for d in 2..isqrt(n):                   // pour n = 2 ou 3, 2..1 est vide
        if n mod d == 0: return false ;
    ;
    return true
;

let primes = parallel {p in 2..10_000, is_prime(p)}
let twins = {(p, p + 2), p in primes, p + 2 in primes}
show("Nombres premiers : {primes.size}")
show("Couples de premiers jumeaux : {twins.size}")
show([p, p in primes, p < 50])
