{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Lion",
  "scopeName": "source.lion",
  "fileTypes": [
    "lion"
  ],
  "patterns": [
    {
      "include": "#expression"
    }
  ],
  "repository": {
    "expression": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#texts"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#declarations"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#types"
        },
        {
          "include": "#calls"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.lion",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.lion",
          "match": "//.*$"
        },
        {
          "name": "comment.block.lion",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.lion"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.lion"
            }
          }
        }
      ]
    },
    "texts": {
      "patterns": [
        {
          "name": "string.quoted.double.lion",
          "begin": "\"",
          "end": "\"|$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.lion"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.lion"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.lion",
              "match": "\\\\[nt\\\\\\\"{}]"
            },
            {
              "name": "invalid.illegal.escape.lion",
              "match": "\\\\."
            },
            {
              "name": "meta.interpolation.lion",
              "contentName": "meta.embedded.expression.lion",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.begin.lion"
                }
              },
              "endCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.end.lion"
                }
              },
              "patterns": [
                {
                  "include": "#expression"
                }
              ]
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.lion",
          "match": "\\b0x[0-9A-Fa-f][0-9A-Fa-f_]*\\b"
        },
        {
          "name": "constant.numeric.binary.lion",
          "match": "\\b0b[01][01_]*\\b"
        },
        {
          "name": "constant.numeric.float.lion",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*(?:e[+-]?[0-9][0-9_]*)?\\b"
        },
        {
          "name": "constant.numeric.integer.lion",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "comment": "fun name, fun Type.method",
          "match": "\\b(fun)\\s+(?:([A-Z][A-Za-z0-9_]*)(\\.))?([a-z][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.function.lion"
            },
            "2": {
              "name": "entity.name.type.lion"
            },
            "3": {
              "name": "punctuation.accessor.lion"
            },
            "4": {
              "name": "entity.name.function.lion"
            }
          }
        },
        {
          "match": "\\b(struct|trait)\\s+([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.lion"
            },
            "2": {
              "name": "entity.name.type.lion"
            }
          }
        },
        {
          "comment": "Color = {red, green}, Shape = Circle or Square",
          "match": "^\\s*([A-Z][A-Za-z0-9_]*)\\s*(=)(?!=)",
          "captures": {
            "1": {
              "name": "entity.name.type.lion"
            },
            "2": {
              "name": "keyword.operator.assignment.lion"
            }
          }
        },
        {
          "match": "\\b(let|var)\\s+([a-z][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.lion"
            },
            "2": {
              "name": "variable.other.declaration.lion"
            }
          }
        },
        {
          "match": "\\b(use)\\s+([a-z][A-Za-z0-9_]*(?:\\.[a-z][A-Za-z0-9_]*)*)",
          "captures": {
            "1": {
              "name": "keyword.control.import.lion"
            },
            "2": {
              "name": "entity.name.namespace.lion"
            }
          }
        },
        {
          "match": "\\b(test)\\s+(?=\\\")",
          "captures": {
            "1": {
              "name": "keyword.other.test.lion"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.lion",
          "match": "\\b(if|elif|else|then|match|otherwise|for|while|break|continue|return|try|task|wait|parallel|expect)\\b"
        },
        {
          "name": "storage.type.lion",
          "match": "\\b(let|var|fun|struct|trait)\\b"
        },
        {
          "name": "keyword.control.import.lion",
          "match": "\\buse\\b"
        },
        {
          "name": "storage.modifier.lion",
          "match": "\\b(private|shared|synced|modifies|infix|foreign|pure|unsafe|compile|test)\\b"
        },
        {
          "name": "keyword.operator.word.lion",
          "match": "\\b(and|or|not|in|as|same|union|inter|minus|subset|div|mod|over|of|maybe)\\b"
        },
        {
          "name": "constant.language.lion",
          "match": "\\b(true|false|none)\\b"
        },
        {
          "name": "variable.language.self.lion",
          "match": "\\bself\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.lion",
          "match": "\\b(Int|Float|Rational|Text|Bool|None|List|Set|Map|Range|Domain|Error|Type|Comparable)\\b"
        },
        {
          "name": "entity.name.type.lion",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "match": "\\b(show|ask|error|exit|reverse|sum|floor|ceil|round|isqrt)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "support.function.builtin.lion"
            }
          }
        },
        {
          "match": "\\b([a-z][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.lion"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.lion",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.compound.lion",
          "match": "\\+=|-=|\\*="
        },
        {
          "name": "keyword.operator.assignment.lion",
          "match": "="
        },
        {
          "name": "keyword.operator.range.lion",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.arithmetic.lion",
          "match": "[-+*/^]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.block.begin.lion",
          "match": ":"
        },
        {
          "name": "punctuation.section.block.end.lion",
          "match": ";"
        },
        {
          "name": "punctuation.separator.comma.lion",
          "match": ","
        },
        {
          "name": "punctuation.accessor.lion",
          "match": "\\."
        }
      ]
    }
  }
}
