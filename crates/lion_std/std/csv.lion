// CSV files (§23): the first line names the columns; `r.get("col")` gives the value
// of a line in a column, or an Error (D37).

use files
use text

struct Row:
    private columns in List of Text
    private values in List of Text
;

// The lines of a CSV text, cut into values (RFC 4180: commas, quotes).
private foreign "lion" fun parse(content in Text) in List of List of Text or Error

// The lines of the file after the first one, which names the columns.
fun read(path in Text) in List of Row or Error:
    let content = try files.read(path)
    let table = try parse(content)
    if table.size == 0: return [] ;
    let columns = table[1]
    return [Row(columns, values), values in table[2..table.size]]
;

// The value of the line in the column named `column`.
fun Row.get(column in Text) in Text or Error:
    for i in 1..self.columns.size:
        if self.columns[i] == column:
            if i > self.values.size: return error("this line has no value in the column `{column}`") ;
            return self.values[i]
        ;
    ;
    return error("there is no column `{column}`")
;

// The CSV text of a table: the names of the columns, then one line per row. A value
// that holds a comma, a quote or a line end is written between quotes (RFC 4180). A row
// that does not have one value per column gives an Error.
fun format(columns in List of Text, rows in List of List of Text) in Text or Error:
    var out = line(columns)
    for i in 1..rows.size:
        if rows[i].size != columns.size:
            let plural = if rows[i].size == 1 then "" else "s"
            return error("the row {i} has {rows[i].size} value{plural} for {columns.size} columns")
        ;
        out = "{out}{line(rows[i])}"
    ;
    return out
;

// Writes the table in the file, as `format` writes it.
fun write(path in Text, columns in List of Text, rows in List of List of Text) in None or Error:
    let content = try format(columns, rows)
    return files.write(path, content)
;

private fun line(values in List of Text) in Text:
    return "{text.join([quoted(v), v in values], ",")}\n"
;

private fun quoted(value in Text) in Text:
    let special = text.contains(value, ",") or text.contains(value, "\"") or text.contains(value, "\n")
    if not special: return value ;
    return "\"{text.replace(value, "\"", "\"\"")}\""
;
