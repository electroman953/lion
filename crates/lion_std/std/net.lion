// The network (§23, C104): web requests, and small HTTP servers.
//
// Requests go through the program `curl`, which brings HTTPS. A server reads its
// requests on threads of its own, so that a slow client delays no one; `serve` answers
// them one at a time, `serve_parallel` several at once (C106). Each `Response` closes
// its connection.

use files
use json
use text

// A header of a request or of a response: `Content-Type: text/html`.
struct Header:
    name in Text
    value in Text
;

// An answer: its status (200, 404…), its headers and its body.
struct Response:
    status in Int
    body in Text
    headers in List of Header
    // A file sent as the body, of any kind: `net.file(path)`.
    private file in Text = ""
    // Bytes sent as the body: `net.bytes(b)` (C117).
    private raw in maybe Bytes = none
;

// A request received by a server. `path` is decoded (`/a%20b` gives `/a b`), without
// what follows `?`.
struct Request:
    method in Text
    path in Text
    body in Text
    headers in List of Header
    // The files sent with a form; they are deleted once the request has its answer.
    uploads in List of Upload
    private query_text in Text
    private connection in Int
    // The names and values taken from the path by a `Router` (`/users/:id`).
    private params in List of Text = []
;

// A file sent with a form (`<input type=file name=photo>`): the name of its field, the
// name of the file on the client, its type (`image/png`…), its size in bytes, and the
// temporary file where the server keeps it. Move or copy it to keep it.
struct Upload:
    field in Text
    filename in Text
    kind in Text
    path in Text
    size in Int
;

// ---------------------------------------------------------------- requests

// Asks for the page at `url`. Any status gives a `Response`, 404 too; an address that
// cannot be reached gives an Error.
fun get(url in Text, headers in List of Header = [], timeout = 30.0) in Response or Error:
    return request("GET", url, headers, "", timeout)
;

// Sends `body` to `url`, as a form unless a `Content-Type` header says otherwise.
fun post(url in Text, body in Text, headers in List of Header = [], timeout = 30.0) in Response or Error:
    return request("POST", url, headers, body, timeout)
;

// Any request: `method` is GET, POST, PUT, PATCH, DELETE…
fun request(method in Text, url in Text, headers in List of Header, body in Text, timeout = 30.0) in Response or Error:
    let answer = try fetch(method, url, flat(headers), body, [], timeout, false, "")
    return Response(number(answer[1]), answer[2], unflat(answer[4..answer.size]))
;

// The body of the answer read as JSON.
fun Response.json() in json.Value or Error = json.decode(self.body)

// A session: requests that keep the cookies the sites give, as a browser does, to stay
// logged in. Its headers go with each of its requests (`User-Agent`, `Authorization`…).
struct Session:
    headers in List of Header
    private cookies in Text
;

// A new session, without cookies.
fun session(headers in List of Header = []) in Session = Session(headers, "")

fun Session.get(var self, url in Text, headers in List of Header = [], timeout = 30.0) in Response or Error:
    return self.request("GET", url, headers, "", timeout)
;

fun Session.post(var self, url in Text, body in Text, headers in List of Header = [], timeout = 30.0) in Response or Error:
    return self.request("POST", url, headers, body, timeout)
;

// A request with the headers and the cookies of the session; the cookies of the answer
// are kept.
fun Session.request(var self, method in Text, url in Text, headers in List of Header, body in Text, timeout = 30.0) in Response or Error:
    var all = flat(self.headers)
    for word in flat(headers): all.add(word) ;
    let answer = try fetch(method, url, all, body, [], timeout, true, self.cookies)
    self.cookies = answer[3]
    return Response(number(answer[1]), answer[2], unflat(answer[4..answer.size]))
;

// The body of the answer at `url` as bytes, an image too; a status from 400 up is an
// Error (C117).
fun get_bytes(url in Text, headers in List of Header = [], timeout = 30.0) in Bytes or Error:
    let (head, body) = try fetch_bytes("GET", url, flat(headers), "", timeout, false, "")
    let status = number(head[1])
    if status >= 400: return error("`{url}` answered {status}") ;
    return body
;

// Saves what `url` gives in the file `path`, images too. A status from 400 up is an
// Error.
fun download(url in Text, path in Text, timeout = 300.0) in None or Error:
    return save(url, path, timeout)
;

// Sends the file `path` in the field `field` of a form (`multipart/form-data`), as a
// browser does; `form` holds the other fields, as `a=1&b=2`.
fun upload(url in Text, field in Text, path in Text, form = "", headers in List of Header = [], timeout = 300.0) in Response or Error:
    let answer = try fetch("POST", url, flat(headers), form, [field, path], timeout, false, "")
    return Response(number(answer[1]), answer[2], unflat(answer[4..answer.size]))
;

// The value of the header `name` of the answer, whatever its case, or `none`.
fun Response.header(name in Text) in maybe Text = find_header(self.headers, name)

// Whether the status says success: from 200 to 299.
fun Response.ok() in Bool = 200 <= self.status <= 299

// `t` written so that it fits in an address: `net.encode("a b/é")` gives
// `a%20b%2F%C3%A9`.
foreign "lion" fun encode(t in Text) in Text

// ---------------------------------------------------------------- servers

// Answers every request with `handle`, forever, on `port` of this computer only. With
// `host = "0.0.0.0"`, other computers reach it too. A handler that gives an Error
// answers 500 with its message. Gives an Error only when the port cannot be used.
fun serve(port in Int, handle in fun(Request) in Response or Error, host = "127.0.0.1") in None or Error:
    let server = try listen(port, host)
    while true:
        let r = try server.next()
        answer(handle, r)
    ;
    return none
;

// As `serve`, but with up to `workers` requests answered at once, each by a task
// (§19.1): a slow answer, such as one that asks another site, delays the others less.
// The answers run at once only when `handle` reads nothing that can change, as any
// task (C85): a `handle` that reads or changes a `var` global, or writes files, gives
// the same answers, one after the other, as with `serve`. What a task shows appears
// when the server waits for it.
fun serve_parallel(port in Int, handle in fun(Request) in Response or Error, workers = 8, host = "127.0.0.1") in None or Error:
    let server = try listen(port, host)
    var running = [] in List of Task of None
    while true:
        let r = try server.next()
        running.add(task answer(handle, r))
        if running.size >= workers:
            let done = wait running[1]
            running = running[2..running.size]
        ;
    ;
    return none
;

// Answers `r` with `handle`; an Error becomes an answer 500.
private fun answer(handle in fun(Request) in Response or Error, r in Request) in None:
    let a = match handle(r):
        in Response a then a
        in Error e then plain(e.message(), 500)
    ;
    // A client that leaves before its answer does not stop the server.
    let sent = r.respond(a)
    return none
;

// A server that waits for requests, to answer them one by one with `next` and
// `respond`; `serve` does both.
struct Server:
    private id in Int
;

// Starts listening on `port`; port 0 lets the system choose a free one.
fun listen(port in Int, host = "127.0.0.1") in Server or Error:
    let id = try listen_on(host, port)
    return Server(id)
;

// The port on which the server listens.
fun Server.port() in Int = server_port(self.id)

// Waits for the next request.
fun Server.next() in Request or Error:
    let r = try accept(self.id)
    let first = r[1]
    let u = r[3]
    let uploads = [Upload(u[5 * i - 4], u[5 * i - 3], u[5 * i - 2], u[5 * i - 1], number(u[5 * i])), i in 1..u.size div 5]
    return Request(first[2], first[3], first[5], unflat(r[2]), uploads, first[4], number(first[1]))
;

// Answers the request; a request has one answer.
fun Request.respond(answer in Response) in None or Error:
    let body = answer.raw otherwise answer.body
    return reply(self.connection, answer.status, flat(answer.headers), body, answer.file)
;

// The value of the header `name`, whatever its case, or `none`.
fun Request.header(name in Text) in maybe Text = find_header(self.headers, name)

// The value of the parameter `name` of the address (`/search?q=lion`), decoded, or
// `none`.
fun Request.query(name in Text) in maybe Text = find_pair(pairs(self.query_text), name)

// The value of the field `name` of a form sent by POST, decoded, or `none`.
fun Request.form(name in Text) in maybe Text = find_pair(pairs(self.body), name)

// The body as it came, of any kind (C117); `body` is empty when it is not UTF-8 text.
// It is read before the answer.
fun Request.bytes() in Bytes = body_bytes(self.connection)

// The file sent in the field `field`, or `none`.
fun Request.upload(field in Text) in maybe Upload:
    for u in self.uploads:
        if u.field == field: return u ;
    ;
    return none
;

// The part of the path that the `Router` took for `:name`, decoded, or `none`.
fun Request.param(name in Text) in maybe Text = find_pair(self.params, name)

// An answer in plain text.
fun plain(body in Text, status = 200) in Response = Response(status, body, [Header("Content-Type", "text/plain; charset=utf-8")])

// An answer in HTML.
fun html(body in Text, status = 200) in Response = Response(status, body, [Header("Content-Type", "text/html; charset=utf-8")])

// An answer that is data in JSON: `net.data(json.from(stats))`.
fun data(v in json.Value, status = 200) in Response = Response(status, v.encode(), [Header("Content-Type", "application/json")])

// An answer that is the file `path`, of any kind; its type comes from its extension
// (`.png`, `.css`…). A file that cannot be read gives the answer 404.
fun file(path in Text, status = 200) in Response = Response(status, "", [], path)

// An answer whose body is bytes, of the type `kind` (`image/png`…) (C117).
fun bytes(b in Bytes, kind = "application/octet-stream", status = 200) in Response:
    return Response(status, "", [Header("Content-Type", kind)], "", b)
;

// An answer that sends the client to `location`.
fun redirect(location in Text, status = 303) in Response = Response(status, "", [Header("Location", location)])

// ---------------------------------------------------------------- routes

// The answers of a site, by method and path: `/users/:id` takes any segment as the
// parameter `id` (`r.param("id")`), and `*` at the end takes the rest of the path. The
// routes are tried in their order. A path known for other methods gives 405; an unknown
// path, a file of a folder given by `files`, or else 404.
//
//     let app = net.router().get("/", home).get("/users/:id", user).files("/static", "public")
//     try net.serve(8080, app.handle)
struct Router:
    private routes in List of Route
    // The prefixes and folders of `files`.
    private folders in List of Text
;

// A route of a `Router`.
struct Route:
    method in Text
    pattern in List of Text
    handle in fun(Request) in Response or Error
;

// A router without routes.
fun router() in Router = Router([], [])

fun Router.get(pattern in Text, handle in fun(Request) in Response or Error) in Router = self.route("GET", pattern, handle)
fun Router.post(pattern in Text, handle in fun(Request) in Response or Error) in Router = self.route("POST", pattern, handle)
fun Router.put(pattern in Text, handle in fun(Request) in Response or Error) in Router = self.route("PUT", pattern, handle)
fun Router.delete(pattern in Text, handle in fun(Request) in Response or Error) in Router = self.route("DELETE", pattern, handle)

// A route for any method, such as PATCH.
fun Router.route(method in Text, pattern in Text, handle in fun(Request) in Response or Error) in Router:
    var routes = self.routes
    routes.add(Route(method, segments(pattern), handle))
    return Router(routes, self.folders)
;

// Serves the files of `folder` under the path `prefix`: with `files("/static", "public")`,
// `/static/css/a.css` gives `public/css/a.css`, and a folder its `index.html`. A path
// with `..` is refused.
fun Router.files(prefix in Text, folder in Text) in Router:
    var folders = self.folders
    folders.add(prefix)
    folders.add(folder)
    return Router(self.routes, folders)
;

// The answer of the site to `r`.
fun Router.handle(r in Request) in Response or Error:
    let path = segments(r.path)
    var allowed = [] in List of Text
    for route in self.routes:
        let params = taken(route.pattern, path)
        if params != none:
            if route.method == r.method or (route.method == "GET" and r.method == "HEAD"):
                return route.handle(Request(r.method, r.path, r.body, r.headers, r.uploads, r.query_text, r.connection, params))
            ;
            if not (route.method in allowed): allowed.add(route.method) ;
        ;
    ;
    if allowed.size > 0:
        return Response(405, "method not allowed\n", [Header("Allow", text.join(allowed, ", ")), Header("Content-Type", "text/plain; charset=utf-8")])
    ;
    for i in 1..self.folders.size div 2:
        let found = in_folder(self.folders[2 * i - 1], self.folders[2 * i], path)
        if found != none and (r.method == "GET" or r.method == "HEAD"): return file(found) ;
    ;
    return plain("no page at {r.path}\n", 404)
;

// The parameters that the pattern takes from the path, or `none` if it does not match.
private fun taken(pattern in List of Text, path in List of Text) in maybe List of Text:
    var params = [] in List of Text
    for i in 1..pattern.size:
        let part = pattern[i]
        if part == "*" and i == pattern.size:
            params.add("*")
            params.add(text.join(path[i..path.size], "/"))
            return params
        ;
        if i > path.size: return none ;
        if text.starts_with(part, ":"):
            params.add(part[2..part.size])
            params.add(path[i])
        elif part != path[i]:
            return none
        ;
    ;
    if path.size != pattern.size: return none ;
    return params
;

// The file of `folder` that the path designates under `prefix`, if it exists.
private fun in_folder(prefix in Text, folder in Text, path in List of Text) in maybe Text:
    let start = segments(prefix)
    if path.size < start.size or path[1..start.size] != start: return none ;
    let rest = path[start.size + 1..path.size]
    for part in rest:
        if part == ".." or part == "." or text.contains(part, "\\"): return none ;
    ;
    var found = folder
    for part in rest: found = "{found}/{part}" ;
    if files.is_folder(found): found = "{found}/index.html" ;
    if not files.exists(found) or files.is_folder(found): return none ;
    return found
;

// The segments of a path, without the empty ones: `/a//b/` gives `["a", "b"]`.
private fun segments(path in Text) in List of Text = [part, part in text.split(path, "/"), part != ""]

// ---------------------------------------------------------------- inside

// The status, the body, the cookies kept, then the names and values of the headers.
private foreign "lion" fun fetch(method in Text, url in Text, headers in List of Text, body in Text, files in List of Text, timeout in Float, session in Bool, cookies in Text) in List of Text or Error
private foreign "lion" fun save(url in Text, path in Text, timeout in Float) in None or Error
private foreign "lion" fun listen_on(host in Text, port in Int) in Int or Error
private foreign "lion" fun server_port(server in Int) in Int
// The connection, the method, the path, the query and the body; the names and values
// of the headers; the field, file name, type, path and size of each upload.
private foreign "lion" fun accept(server in Int) in List of List of Text or Error
private foreign "lion" fun reply(connection in Int, status in Int, headers in List of Text, body in Text or Bytes, file in Text) in None or Error
// The status, the cookies kept, the names and values of the headers; and the body.
private foreign "lion" fun fetch_bytes(method in Text, url in Text, headers in List of Text, body in Text, timeout in Float, session in Bool, cookies in Text) in (List of Text, Bytes) or Error
private foreign "lion" fun body_bytes(connection in Int) in Bytes
// The names and the values of a query or a form, decoded.
private foreign "lion" fun pairs(t in Text) in List of Text

private fun flat(headers in List of Header) in List of Text:
    var out = [] in List of Text
    for h in headers:
        out.add(h.name)
        out.add(h.value)
    ;
    return out
;

private fun unflat(words in List of Text) in List of Header = [Header(words[2 * i - 1], words[2 * i]), i in 1..words.size div 2]

private fun find_header(headers in List of Header, name in Text) in maybe Text:
    let wanted = text.lower(name)
    for h in headers:
        if text.lower(h.name) == wanted: return h.value ;
    ;
    return none
;

private fun find_pair(words in List of Text, name in Text) in maybe Text:
    for i in 1..words.size div 2:
        if words[2 * i - 1] == name: return words[2 * i] ;
    ;
    return none
;

private fun number(t in Text) in Int:
    return match t as Int:
        in Int n then n
        otherwise then 0
    ;
;
