// Files (§23): every operation that can fail gives `T or Error`.

use text

// The content of the file, as a Text.
foreign "lion" fun read(path in Text) in Text or Error

// Replaces the content of the file, creating it when needed.
foreign "lion" fun write(path in Text, content in Text) in None or Error

// Whether a file or a folder exists at this path.
foreign "lion" fun exists(path in Text) in Bool

// The lines of the file, without their ends.
fun lines(path in Text) in List of Text or Error:
    let content = try read(path)
    return text.lines(content)
;

// Adds `content` at the end of the file, creating it when needed.
foreign "lion" fun append(path in Text, content in Text) in None or Error

// The names of what the folder holds, files and folders, in alphabetical order.
foreign "lion" fun list(folder in Text) in List of Text or Error

// Whether a folder exists at this path.
foreign "lion" fun is_folder(path in Text) in Bool

// Creates the folder, and the folders above it when needed.
foreign "lion" fun make_folder(path in Text) in None or Error

// Deletes a file, or a folder that is empty.
foreign "lion" fun remove(path in Text) in None or Error

// Copies the file `from` to `to`, which it replaces.
foreign "lion" fun copy(from in Text, to in Text) in None or Error

// Moves or renames a file or a folder.
foreign "lion" fun move(from in Text, to in Text) in None or Error

// Every file inside the folder and its folders, as paths from it (`2026/a.jpg`), in
// alphabetical order. A link to a folder is not followed.
foreign "lion" fun walk(folder in Text) in List of Text or Error

// The files inside the folder whose path matches the pattern, each with the folder before
// it (`photos/2026/a.jpg`): `*` any characters but `/`, `?` one, `**` any folders,
// `[a-z]` one of them, `{jpg,png}` one of the words. A pattern without `/` looks at the
// names only: `files.find("photos", "*.\{jpg,png\}")` finds them in every folder.
fun find(folder in Text, pattern in Text) in List of Text or Error:
    let all = try walk(folder)
    return ["{folder}/{path}", path in all, matches(pattern, path)]
;

// Whether the path matches the pattern, as `find` does.
foreign "lion" fun matches(pattern in Text, path in Text) in Bool

// The size of the file, in bytes.
foreign "lion" fun size(path in Text) in Int or Error

// When the file was last changed, in seconds since 1970-01-01 at 00:00 UTC, as
// `time.now()`.
foreign "lion" fun modified(path in Text) in Float or Error
