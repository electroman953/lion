// Texts (§23): searching, splitting, replacing, changing the case. Positions count
// characters, from 1, as `t[i]` (§16.2).

// The parts of `t` between the separators; an empty separator is refused (bug).
foreign "lion" fun split(t in Text, separator in Text) in List of Text

// The parts, with the separator between them.
foreign "lion" fun join(parts in List of Text, separator in Text) in Text

foreign "lion" fun upper(t in Text) in Text
foreign "lion" fun lower(t in Text) in Text

// Without the spaces, tabs and line ends at both ends.
foreign "lion" fun trim(t in Text) in Text

foreign "lion" fun contains(t in Text, part in Text) in Bool
foreign "lion" fun starts_with(t in Text, start in Text) in Bool
foreign "lion" fun ends_with(t in Text, end in Text) in Bool

// Every occurrence of `old` replaced by `new`.
foreign "lion" fun replace(t in Text, old in Text, new in Text) in Text

// The position of the first occurrence of `part`, or `none`.
foreign "lion" fun find(t in Text, part in Text) in maybe Int

// The lines, without their ends (`\n` or `\r\n`).
foreign "lion" fun lines(t in Text) in List of Text

// The texts in the order of a dictionary (C109): without regard to case and accents
// (`é` as `e`), then by their characters: `["zèbre", "Été", "abc"]` gives
// `["abc", "Été", "zèbre"]`.
foreign "lion" fun sorted(l in List of Text) in List of Text

// -1, 0 or 1, as `a` comes before `b`, is equal to it, or comes after, in the order of
// `sorted`.
foreign "lion" fun compare(a in Text, b in Text) in Int

// Whether `a` comes before `b` in the order of `sorted`.
fun before(a in Text, b in Text) in Bool = compare(a, b) < 0

// `t` written `n` times: `text.repeat("-", 3)` gives `---`. A negative count is a bug.
foreign "lion" fun repeat(t in Text, n in Int) in Text

// `t` with `fill` before it up to `width` characters: `text.pad_left("7", 3, "0")` gives
// `007`. A longer text stays as it is.
fun pad_left(t in Text, width in Int, fill = " ") in Text:
    if t.size >= width or fill == "": return t ;
    return "{repeat(fill, width - t.size)}{t}"
;

// `t` with `fill` after it up to `width` characters.
fun pad_right(t in Text, width in Int, fill = " ") in Text:
    if t.size >= width or fill == "": return t ;
    return "{t}{repeat(fill, width - t.size)}"
;

// A number written with `digits` decimals: `text.fixed(12.5, 2)` gives `12.50`.
// The rounding is that of the nearest value, on the exact Float (2.675 is 2.67499…).
foreign "lion" fun fixed(x in Float, digits in Int) in Text
